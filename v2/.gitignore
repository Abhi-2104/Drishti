# Root .gitignore ignores tests/ (v1 scratch); v2 tests are tracked.
!tests/

# Scout run outputs: regenerate locally, do not commit
phase0/scout/retest_*.json
phase0/scout/retest_report.md

# Test fixtures are copies of exchange / data-provider responses: data, kept out of git. Their checksums are tracked in
# tests/fixtures.lock; move them between machines with tests/fixtures_tool.py pack / unpack.
tests/fixtures/
