# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Node (nse-mcp build output + deps — regenerated by install.sh / npm run build)
node_modules/
dist/

# WSL cruft (files are named "<name>:Zone.Identifier" — colon, not dot)
*Zone.Identifier

# Reference clones — each has its own nested .git, so they're not tracked here
# (reproducible via install.sh). NOTE: reference/NSE-MCP carries our custom tools
# (get_screener, get_bse_announcements) as local patches on disk + documented in
# memory; vendoring those cleanly into version control is a later task, deliberately
# not done in the Task-001 baseline to avoid a nested-repo side quest.
# (reference/india_data_client.py and reference/PORT_NOTES.md ARE tracked — they sit
#  at reference/ root, not inside a clone.)
reference/ai-hedge-fund/
reference/TradingAgents/
reference/NSE-MCP/

# Local scratch
scratchpad/
*.log

# Build scaffolding + test data — kept locally, not in the repo
.agents/
tests/
